<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permanent UI map: embedded so it ships inside the binary regardless
         of installer layout. UiMap loads it as "inbrisk.uimap.json". -->
    <EmbeddedResource Include="..\..\resources\uimap.json" LogicalName="inbrisk.uimap.json" />
  </ItemGroup>

</Project>
